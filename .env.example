# Monorepo environment reference for local and deployment setup.

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api

# Backend
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://data-visualization-tool-5cwg.onrender.com
CORS_ALLOW_CREDENTIALS=false

# MongoDB (centralized assignment storage)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority
MONGODB_DB_NAME=datascience_lab
MONGODB_ASSIGNMENTS_COLLECTION=student_assignments
MONGODB_SETTINGS_COLLECTION=assignment_settings
MONGODB_STUDENTS_COLLECTION=students

# Centralized assignment + app data store
# Render persistent disk example:
DATA_URI=sqlite:///var/data/lab.db

# Optional legacy path-style setting
# DB_PATH=./backend/data/lab.db
